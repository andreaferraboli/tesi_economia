%!
% Definizione OutputIntent per PDF/A (Ghostscript pdfwrite)
/ICCProfile (C:/Users/andre/AppData/Local/Programs/MiKTeX/tex/generic/colorprofiles/sRGB.icc) def

[ /Title (Adeguatezza pensionistica e autonomia previdenziale)
  /Author (Andrea Ferraboli)
  /DOCINFO pdfmark

[/_objdef {icc_PDFA} /type /stream /OBJ pdfmark
[{icc_PDFA} <</N 3 /Alternate /DeviceRGB>> /PUT pdfmark
[{icc_PDFA} ICCProfile (r) file /PUT pdfmark
[/_objdef {OutputIntent_PDFA} /type /dict /OBJ pdfmark
[{OutputIntent_PDFA} <<
  /Type /OutputIntent
  /S /GTS_PDFA1
  /DestOutputProfile {icc_PDFA}
  /OutputConditionIdentifier (sRGB)
  /Info (sRGB IEC61966-2.1)
>> /PUT pdfmark
[{Catalog} <</OutputIntents [ {OutputIntent_PDFA} ]>> /PUT pdfmark
